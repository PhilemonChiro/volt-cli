  "specs": {
    "voltage": "2.2V \u2013 5.5V",
    "current": "23 \u03bcA measure, 0.25 \u03bcA sleep",
    "temp_range": "\u221240\u00b0C to +85\u00b0C \u00b10.3\u00b0C",
    "humidity_range": "0\u2013100% RH \u00b12%",
