{
  "name": "LCD20x4",
  "category": "display",
  "interface": "i2c",
  "max_speed": 100000,
  "default_address": "0x27",
  "addresses": ["0x27", "0x20", "0x21", "0x22", "0x23", "0x24", "0x25", "0x26", "0x3F", "0x38", "0x39", "0x3A", "0x3B", "0x3C", "0x3D", "0x3E"],
  "description": "20x4 character LCD display (I2C backpack)",
  "c_prefix": "hd44780",
  "c_source": "",
  "init_args": "{bus_id}, {addr}, 20, 4",
  "methods": {
    "clear": {
      "returns": "void",
      "params": [],
      "description": "Clear the display"
    },
    "print": {
      "returns": "void",
      "params": [
        {
          "name": "text",
          "type": "string"
        }
      ],
      "description": "Print text at cursor"
    },
    "set_cursor": {
      "returns": "void",
      "params": [
        {
          "name": "col",
          "type": "int"
        },
        {
          "name": "row",
          "type": "int"
        }
      ],
      "description": "Move cursor (col 0-19, row 0-3)"
    },
    "backlight": {
      "returns": "void",
      "params": [
        {
          "name": "on",
          "type": "int"
        }
      ],
      "description": "Toggle backlight on/off"
    },
    "create_char": {
      "returns": "void",
      "params": [
        {
          "name": "slot",
          "type": "int"
        },
        {
          "name": "r0",
          "type": "int"
        },
        {
          "name": "r1",
          "type": "int"
        },
        {
          "name": "r2",
          "type": "int"
        },
        {
          "name": "r3",
          "type": "int"
        },
        {
          "name": "r4",
          "type": "int"
        },
        {
          "name": "r5",
          "type": "int"
        },
        {
          "name": "r6",
          "type": "int"
        },
        {
          "name": "r7",
          "type": "int"
        }
      ],
      "description": "Define custom character 0-7 from 8 rows of 5-bit pixels (top to bottom)"
    },
    "write_char": {
      "returns": "void",
      "params": [
        {
          "name": "code",
          "type": "int"
        }
      ],
      "description": "Write a raw character code at the cursor (0-7 = custom chars)"
    },
    "reinit": {
      "returns": "void",
      "params": [],
      "description": "Re-initialise the display (recovers garbled characters after noise or a supply dip); redraw afterwards"
    }
  },
  "manufacturer": "Generic (HD44780 + PCF8574 backpack)",
  "datasheet": "https://www.sparkfun.com/datasheets/LCD/HD44780.pdf",
  "specs": {
    "voltage": "5V",
    "current": "1.5 mA + ~30 mA backlight",
    "characters": "20 columns × 4 rows",
    "interface_speed": "I²C up to 100 kHz"
  },
  "wiring": {
    "pins": [
      {
        "label": "VCC",
        "type": "power",
        "note": "3.3V or 5V"
      },
      {
        "label": "GND",
        "type": "ground",
        "note": ""
      },
      {
        "label": "SDA",
        "type": "data",
        "note": "Pull-up to VCC (often on breakout board)"
      },
      {
        "label": "SCL",
        "type": "clock",
        "note": "Pull-up to VCC"
      },
      {
        "label": "Backlight jumper",
        "type": "power",
        "note": "Pull to disable backlight"
      }
    ]
  },
  "tips": [
    "Line addressing isn't sequential — line 3 starts at column 0x00+0x14, line 4 at 0x40+0x14. Most drivers hide this.",
    "Drawing 80 chars over I²C at 100 kHz takes ~50 ms — avoid refreshing the whole screen every frame."
  ],
  "alternatives": [
    {
      "name": "SSD1306",
      "note": "OLED — smaller package but you get graphics."
    },
    {
      "name": "ST7789",
      "note": "Color TFT — more pixels, more flexibility, more code."
    }
  ]
}
