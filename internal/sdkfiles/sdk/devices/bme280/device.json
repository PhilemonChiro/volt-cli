{
  "name": "BME280",
  "category": "sensor",
  "interface": "i2c",
  "default_address": "0x76",
  "addresses": ["0x76", "0x77"],
  "description": "Temperature, humidity, pressure",
  "c_prefix": "bme280",
  "c_source": "sensor_bme280.c",
  "methods": {
    "temperature": {
      "returns": "float",
      "params": [],
      "description": "Temperature in \u00b0C"
    },
    "humidity": {
      "returns": "float",
      "params": [],
      "description": "Relative humidity %"
    },
    "pressure": {
      "returns": "float",
      "params": [],
      "description": "Pressure in hPa"
    }
  },
  "manufacturer": "Bosch Sensortec",
  "datasheet": "https://www.bosch-sensortec.com/media/boschsensortec/downloads/datasheets/bst-bme280-ds002.pdf",
  "specs": {
    "voltage": "1.71V \u2013 3.6V (most breakouts have a regulator for 5V)",
    "current": "3.6 \u03bcA at 1 Hz",
    "temp": "\u221240\u00b0C to +85\u00b0C \u00b11.0\u00b0C",
    "humidity": "0\u2013100% RH \u00b13%",
    "pressure": "300 \u2013 1100 hPa \u00b11.0 hPa (\u2248 \u00b11 m altitude)",
    "interface_speed": "I\u00b2C up to 3.4 MHz or SPI up to 10 MHz"
  },
  "wiring": {
    "pins": [
      {
        "label": "VCC",
        "type": "power",
        "note": "3.3V or 5V"
      },
      {
        "label": "GND",
        "type": "ground",
        "note": ""
      },
      {
        "label": "SDA",
        "type": "data",
        "note": "Pull-up to VCC (often on breakout board)"
      },
      {
        "label": "SCL",
        "type": "clock",
        "note": "Pull-up to VCC"
      },
      {
        "label": "CSB",
        "type": "data",
        "note": "Tie to VCC for I\u00b2C (low = SPI mode)"
      },
      {
        "label": "SDO",
        "type": "data",
        "note": "Address select: GND=0x76, VCC=0x77"
      }
    ]
  },
  "tips": [
    "BME280 = BMP280 + humidity. Don't buy a BMP280 thinking it has humidity.",
    "First reading after power-up is junk \u2014 discard it.",
    "Default oversampling is fine for weather; bump pressure oversampling for altimeter use."
  ],
  "alternatives": [
    {
      "name": "BME680",
      "note": "Adds VOC gas sensing on top \u2014 costs more, draws more current."
    },
    {
      "name": "BMP280",
      "note": "No humidity sensor; cheaper and slightly smaller package."
    }
  ]
}
