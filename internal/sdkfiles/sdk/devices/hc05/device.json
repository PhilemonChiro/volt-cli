{
  "c_prefix": "hc05",
  "c_source": "driver.c",
  "category": "rf",
  "datasheet": "https://www.electronicoscaldas.com/datasheet/HC-05.pdf",
  "default_address": "",
  "description": "Driver for HC-05 Bluetooth module using UART with extended AT command support.",
  "init_args": "{uart_id}",
  "interface": "uart",
  "params": {"baud": {"type": "int", "default": 9600}},
  "methods": {
    "read_at_response": {
      "description": "Reads the response from an AT command.",
      "params": [
        {
          "name": "response",
          "type": "char *"
        },
        {
          "name": "max_len",
          "type": "uint16_t"
        }
      ],
      "returns": "int"
    },
    "receive_data": {
      "description": "Receives data over Bluetooth.",
      "params": [
        {
          "name": "buffer",
          "type": "char *"
        },
        {
          "name": "max_len",
          "type": "uint16_t"
        }
      ],
      "returns": "int"
    },
    "send_at_command": {
      "description": "Sends an AT command to the HC-05 module.",
      "params": [
        {
          "name": "command",
          "type": "const char *"
        }
      ],
      "returns": "void"
    },
    "send_data": {
      "description": "Sends data over Bluetooth.",
      "params": [
        {
          "name": "data",
          "type": "int"
        }
      ],
      "returns": "void"
    },
    "set_baud_rate": {
      "description": "Sets the baud rate of the HC-05 module.",
      "params": [
        {
          "name": "baud_rate",
          "type": "int"
        }
      ],
      "returns": "void"
    },
    "set_name": {
      "description": "Sets the name of the HC-05 module.",
      "params": [
        {
          "name": "name",
          "type": "const char *"
        }
      ],
      "returns": "void"
    },
    "set_password": {
      "description": "Sets the password of the HC-05 module.",
      "params": [
        {
          "name": "password",
          "type": "const char *"
        }
      ],
      "returns": "void"
    }
  },
  "name": "HC05"
}
