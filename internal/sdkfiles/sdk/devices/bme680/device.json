{
  "name": "BME680",
  "category": "sensor",
  "interface": "i2c",
  "default_address": "0x76",
  "addresses": ["0x76", "0x77"],
  "description": "Gas, temperature, humidity, pressure",
  "c_prefix": "bme680",
  "c_source": "sensor_bme680.c",
  "methods": {
    "temperature": {
      "returns": "float",
      "params": [],
      "description": "Temperature in \u00b0C"
    },
    "humidity": {
      "returns": "float",
      "params": [],
      "description": "Humidity %"
    },
    "pressure": {
      "returns": "float",
      "params": [],
      "description": "Pressure in hPa"
    },
    "gas": {
      "returns": "int",
      "params": [],
      "description": "Gas resistance"
    }
  },
  "manufacturer": "Bosch Sensortec",
  "datasheet": "https://www.bosch-sensortec.com/media/boschsensortec/downloads/datasheets/bst-bme680-ds001.pdf",
  "specs": {
    "voltage": "1.71V \u2013 3.6V",
    "current": "0.15 \u03bcA sleep, ~3.7 mA during gas measurement",
    "temp": "\u221240\u00b0C to +85\u00b0C \u00b11.0\u00b0C",
    "humidity": "0\u2013100% RH \u00b13%",
    "pressure": "300 \u2013 1100 hPa \u00b10.6 hPa",
    "gas": "VOC / IAQ index (relative, not ppm)"
  },
  "wiring": {
    "pins": [
      {
        "label": "VCC",
        "type": "power",
        "note": "3.3V or 5V"
      },
      {
        "label": "GND",
        "type": "ground",
        "note": ""
      },
      {
        "label": "SDA",
        "type": "data",
        "note": "Pull-up to VCC (often on breakout board)"
      },
      {
        "label": "SCL",
        "type": "clock",
        "note": "Pull-up to VCC"
      },
      {
        "label": "CSB",
        "type": "data",
        "note": "Tie to VCC for I\u00b2C"
      },
      {
        "label": "SDO",
        "type": "data",
        "note": "Address select: GND=0x76, VCC=0x77"
      }
    ]
  },
  "tips": [
    "Gas reading is relative IAQ \u2014 needs Bosch's BSEC library for calibrated ppm-equivalent values.",
    "First gas readings drift for ~5 minutes after power-on \u2014 sensor element is heating up.",
    "Power-cycling resets the IAQ baseline; keep it powered continuously for stable readings."
  ],
  "alternatives": [
    {
      "name": "SCD30",
      "note": "Real CO\u2082 (NDIR) \u2014 accurate ppm but bigger and pricier."
    },
    {
      "name": "BME280",
      "note": "Drop the gas sensor if you only need T/H/P."
    }
  ]
}
